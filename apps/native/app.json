{
  "expo": {
    "scheme": "moneyroad.ai.kr",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "name": "머니로드",
    "slug": "moneyroad-app",
    "version": "1.0.1",
    "icon": "./assets/images/icon.png",
    "plugins": ["expo-font", "expo-notifications"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "kr.ai.moneyroad",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#256EF4"
      }
    },
    "ios": {
      "bundleIdentifier": "kr.ai.moneyroad",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "b2ba4ca6-8c07-4b3a-8862-6517c665fe7c"
      }
    },
    "owner": "mkvista",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b2ba4ca6-8c07-4b3a-8862-6517c665fe7c"
    }
  }
}
