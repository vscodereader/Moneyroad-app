{
  "cli": {
    "version": ">= 19.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://api-staging.moneyroad.ai.kr"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://api.moneyroad.ai.kr"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_ASC_APP_ID"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
